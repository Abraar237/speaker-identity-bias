# Secrets — NEVER commit
.env
.env.*
*.pem
*token*

# Raw audio clips — large, regenerable from experiments/*.py against the
# frozen answer_bank.json + API. Not tracked to keep repo size sane.
experiments/clips/
experiments/clips_excluded_wer_fail/

# Third-party material — do not redistribute another team's paper PDF
reference/*.pdf

# Internal tooling bundle — not part of this project's contribution
Agent Skills/

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/

# LaTeX build artifacts (tectonic normally skips these, kept as a guard)
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/page*.png

# Redundant intermediate (kept: figures/*.png; not kept: base64 dump used only for site build)
figures/figure1_b64.txt

# Film build internals — renders are kept; toolchain and intermediates are not
video/film/remotion/node_modules/
video/film/remotion/out/
video/film/audio/*.wav
video/film/final_v2.mp4

# L2-ARCTIC raw corpus — CC BY-NC 4.0, registration-gated; do NOT re-mirror.
# Derived 16kHz judged clips are fine to publish; raw archives are not.
experiments/l2arctic/raw/
experiments/l2arctic/*.zip
experiments/l2arctic/*.tar.bz2
